cabal-version: 3.4
name: shortest-path-model
version: 1.0.0.0
synopsis: Exact transport-aware OSRS tile pathfinding
description: Exact and near-exact Old School RuneScape tile pathfinding with account-aware transports and reproducible benchmarks.
category: Algorithms
maintainer: Matthew Pickering <matthewtpickering@gmail.com>
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

data-files:
  data/routing-separators-v1.json

source-repository head
  type: git
  location: https://github.com/mpickering/shortest-path-model.git

common warnings
  ghc-options: -O2 -fspecialise-aggressively -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

library
  import: warnings
  ghc-options: -fexpose-all-unfoldings -msse4.2
  exposed-modules:
    ShortestPath.Account
    ShortestPath.AccountSemantics
    ShortestPath.BenchmarkProfiles
    ShortestPath.GameVars
    ShortestPath.GameVars.Varbits
    ShortestPath.GameVars.VarPlayers
    ShortestPath.Internal.Cost
    ShortestPath.Internal.DistanceTransform
    ShortestPath.Internal.MutableHeap
    ShortestPath.Internal.Timing
    ShortestPath.Items
    ShortestPath.Exact.ReferenceDijkstra
    ShortestPath.Exact.TileAStar
    ShortestPath.Exact.TileAStar.Cache
    ShortestPath.Exact.TileAStar.Configuration
    ShortestPath.Exact.TileAStar.Heuristic
    ShortestPath.Exact.TileAStar.HeuristicScan
    ShortestPath.Exact.TileAStar.Preprocessing
    ShortestPath.Exact.TileAStar.Reconstruct
    ShortestPath.Exact.TileAStar.RelaxedGraph
    ShortestPath.Exact.TileAStar.ReverseSearch
    ShortestPath.Exact.TileAStar.Search
    ShortestPath.Exact.TileAStar.SparseWalking
    ShortestPath.Exact.TileAStar.StaticArtifact
    ShortestPath.Exact.TileAStar.Types
    ShortestPath.Pathfinder
    ShortestPath.Requirements
    ShortestPath.Separator
    ShortestPath.Tile
    ShortestPath.Topology
    ShortestPath.Transport
    ShortestPath.Tsv
    ShortestPath.Wilderness
    ShortestPath.World
  other-modules:
    Paths_shortest_path_model
  hs-source-dirs: src
  c-sources:
    csrc/distance_transform.c
  build-depends:
    base >=4.20 && <5,
    aeson,
    binary,
    bytestring,
    containers,
    directory,
    filepath,
    ghc-internal,
    text,
    time,
    vector,
    zip-archive
  default-language: GHC2024

executable account-profile
  import: warnings
  main-is: AccountProfile.hs
  hs-source-dirs: tools/account-profiles
  build-depends:
    base,
    containers,
    shortest-path-model
  default-language: GHC2024

executable separator-artifact
  import: warnings
  main-is: SeparatorArtifact.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    shortest-path-model,
    vector,
    process
  default-language: GHC2024

executable routing-artifact
  import: warnings
  main-is: RoutingArtifact.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    binary,
    bytestring,
    containers,
    directory,
    filepath,
    shortest-path-model,
    vector
  default-language: GHC2024

executable route-bench
  import: warnings
  ghc-options: -threaded -rtsopts
  main-is: RouteBench.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    process,
    shortest-path-model,
    text,
    time
  default-language: GHC2024

executable route-query
  import: warnings
  main-is: RouteQuery.hs
  hs-source-dirs: app
  build-depends:
    base,
    shortest-path-model
  default-language: GHC2024

executable world-facts
  import: warnings
  main-is: WorldFacts.hs
  hs-source-dirs: tools/world-facts
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    hashable,
    process,
    shortest-path-model,
    text,
    time
  default-language: GHC2024

test-suite smoke
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Smoke.hs
  hs-source-dirs: test
  build-depends:
    base,
    containers,
    shortest-path-model
  default-language: GHC2024

test-suite account-mounted-poh
  import: warnings
  type: exitcode-stdio-1.0
  main-is: AccountMountedPoh.hs
  hs-source-dirs: test
  build-depends:
    base,
    containers,
    shortest-path-model
  default-language: GHC2024

test-suite pathfinder-synthetic
  import: warnings
  type: exitcode-stdio-1.0
  main-is: PathfinderSynthetic.hs
  hs-source-dirs: test
  build-depends:
    base,
    bytestring,
    containers,
    shortest-path-model,
    vector
  default-language: GHC2024

test-suite tile-astar
  import: warnings
  type: exitcode-stdio-1.0
  main-is: TileAStar.hs
  hs-source-dirs: test
  build-depends:
    base,
    bytestring,
    containers,
    shortest-path-model
  default-language: GHC2024

test-suite separator-topology
  import: warnings
  type: exitcode-stdio-1.0
  main-is: SeparatorTopology.hs
  hs-source-dirs: test
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    shortest-path-model,
    vector
  default-language: GHC2024

test-suite routing-static-artifact
  import: warnings
  type: exitcode-stdio-1.0
  main-is: RoutingStaticArtifact.hs
  hs-source-dirs: test
  build-depends:
    base,
    bytestring,
    containers,
    shortest-path-model,
    vector
  default-language: GHC2024
