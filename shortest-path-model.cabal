cabal-version: 3.4
name: shortest-path-model
version: 0.1.0.0
build-type: Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

library
  import: warnings
  exposed-modules:
    ShortestPath.Exact.Dijkstra
    ShortestPath.Pathfinder
    ShortestPath.Requirements
    ShortestPath.Tile
    ShortestPath.Transport
    ShortestPath.Tsv
    ShortestPath.World
  hs-source-dirs: src
  build-depends:
    base >=4.20 && <4.21,
    aeson,
    binary,
    bytestring,
    containers,
    directory,
    filepath,
    text,
    time,
    zip-archive
  default-language: GHC2024

executable shortest-path-model
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    filepath,
    hashable,
    shortest-path-model,
    text
  default-language: GHC2024

executable graph-census
  import: warnings
  main-is: GraphCensus.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    shortest-path-model,
    text,
    time,
    vector
  default-language: GHC2024

test-suite smoke
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Smoke.hs
  hs-source-dirs: test
  build-depends:
    base,
    shortest-path-model
  default-language: GHC2024
