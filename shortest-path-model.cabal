cabal-version: 3.4
name: shortest-path-model
version: 0.1.0.0
build-type: Simple

common warnings
  ghc-options: -O2 -fspecialise-aggressively -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -rtsopts

library
  import: warnings
  ghc-options: -fexpose-all-unfoldings -msse4.2
  exposed-modules:
    ShortestPath.Account
    ShortestPath.AccountSemantics
    ShortestPath.BenchmarkProfiles
    ShortestPath.GameVars
    ShortestPath.GameVars.Varbits
    ShortestPath.GameVars.VarPlayers
    ShortestPath.Internal.Cost
    ShortestPath.Internal.DistanceTransform
    ShortestPath.Internal.MutableHeap
    ShortestPath.Internal.RgbaTile
    ShortestPath.Internal.Timing
    ShortestPath.Items
    ShortestPath.Exact.ReferenceDijkstra
    ShortestPath.Exact.TileAStar
    ShortestPath.Exact.TileAStar.Configuration
    ShortestPath.Exact.TileAStar.Debug
    ShortestPath.Exact.TileAStar.Heuristic
    ShortestPath.Exact.TileAStar.HeuristicScan
    ShortestPath.Exact.TileAStar.Preprocessing
    ShortestPath.Exact.TileAStar.Reconstruct
    ShortestPath.Exact.TileAStar.RelaxedGraph
    ShortestPath.Exact.TileAStar.ReverseSearch
    ShortestPath.Exact.TileAStar.Search
    ShortestPath.Exact.TileAStar.SparseWalking
    ShortestPath.Exact.TileAStar.StaticArtifact
    ShortestPath.Exact.TileAStar.Types
    ShortestPath.Pathfinder
    ShortestPath.Requirements
    ShortestPath.Separator
    ShortestPath.Tile
    ShortestPath.Topology
    ShortestPath.Transport
    ShortestPath.Tsv
    ShortestPath.Wilderness
    ShortestPath.World
  hs-source-dirs: src
  c-sources:
    csrc/tile_astar_render.c
  build-depends:
    base >=4.20 && <5,
    aeson,
    binary,
    bytestring,
    containers,
    directory,
    filepath,
    ghc-internal,
    text,
    time,
    vector,
    zip-archive
  default-language: GHC2024

executable shortest-path-model
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    filepath,
    hashable,
    shortest-path-model,
    text
  default-language: GHC2024

executable graph-census
  import: warnings
  main-is: GraphCensus.hs
  hs-source-dirs: app
  build-depends:
    aeson,
