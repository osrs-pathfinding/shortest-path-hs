cabal-version: 3.4
name: shortest-path-model
version: 0.1.0.0
build-type: Simple

common warnings
  ghc-options: -O2 -fspecialise-aggressively -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns

library
  import: warnings
  exposed-modules:
    ShortestPath.Account
    ShortestPath.BenchmarkProfiles
    ShortestPath.Exact.Dijkstra
    ShortestPath.Exact.Hierarchical
    ShortestPath.Exact.RawDijkstra
    ShortestPath.Exact.TileAStar
    ShortestPath.Hierarchy.Partition
    ShortestPath.Hierarchy.Preprocess
    ShortestPath.Hierarchy.Types
    ShortestPath.Heuristic.Region
    ShortestPath.Pathfinder
    ShortestPath.Requirements
    ShortestPath.Tile
    ShortestPath.Transport
    ShortestPath.Tsv
    ShortestPath.World
  hs-source-dirs: src
  c-sources:
    csrc/tile_astar_render.c
  build-depends:
    base >=4.20 && <4.21,
    aeson,
    binary,
    bytestring,
    containers,
    directory,
    filepath,
    pqueue,
    text,
    time,
    vector,
    zip-archive
  default-language: GHC2024

executable shortest-path-model
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    filepath,
    hashable,
    shortest-path-model,
    text
  default-language: GHC2024

executable graph-census
  import: warnings
  main-is: GraphCensus.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    shortest-path-model,
    text,
    time,
    vector
  default-language: GHC2024

executable account-profile
  import: warnings
  main-is: AccountProfile.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    containers,
    shortest-path-model
  default-language: GHC2024

executable metis-partition
  import: warnings
  main-is: MetisPartition.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    shortest-path-model,
    vector,
    process
  default-language: GHC2024

executable hierarchy-differential
  import: warnings
  main-is: HierarchyDifferential.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    binary,
    bytestring,
    containers,
    directory,
    filepath,
    shortest-path-model,
    vector
  default-language: GHC2024

executable route-bench
  import: warnings
  main-is: RouteBench.hs
  hs-source-dirs: app
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    process,
    shortest-path-model,
    text,
    time
  default-language: GHC2024

test-suite smoke
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Smoke.hs
  hs-source-dirs: test
  build-depends:
    base,
    containers,
    shortest-path-model
  default-language: GHC2024

test-suite hierarchy-synthetic
  import: warnings
  type: exitcode-stdio-1.0
  main-is: HierarchySynthetic.hs
  hs-source-dirs: test
  build-depends:
    base,
    binary,
    bytestring,
    containers,
    shortest-path-model
  default-language: GHC2024

test-suite tile-astar
  import: warnings
  type: exitcode-stdio-1.0
  main-is: TileAStar.hs
  hs-source-dirs: test
  build-depends:
    base,
    shortest-path-model
  default-language: GHC2024
