#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   scripts/clickhouse-medians
#   scripts/clickhouse-medians --host localhost --port 9000
#   scripts/clickhouse-medians --host ... --user ... --password ...
#
# Any arguments are passed directly to clickhouse-client.

CH=(clickhouse-client "$@")

query() {
    "${CH[@]}" --format PrettyCompactMonoBlock --query "$1"
}

RUN_ID="$("${CH[@]}" --format TSVRaw --query "
    SELECT run_id
    FROM osrs_bench.runs
    ORDER BY created_at DESC, run_id DESC
    LIMIT 1
")"

if [[ -z "$RUN_ID" ]]; then
    echo "No benchmark runs found" >&2
    exit 1
fi

# run_id should normally be UUID-ish, but quote it safely anyway.
RUN_ID_SQL=${RUN_ID//\'/\'\'}

echo
echo "=== Latest run ==="
query "
SELECT
    run_id,
    created_at,
    git_commit,
    corpus_id,
    profile_set_id,
    suite_id,
    case_count,
    testbed,
    hostname
FROM osrs_bench.runs
WHERE run_id = '$RUN_ID_SQL'
"

echo
echo "=== Correctness ==="
query "
SELECT
    count() AS samples,
    countIf(status = 'ok') AS ok_count,
    countIf(correct = 1) AS correct_count,
    countIf(status != 'ok') AS failed_count,
    countIf(correct != 1) AS incorrect_count
FROM osrs_bench.samples
WHERE run_id = '$RUN_ID_SQL'
"

echo
echo "=== Timing percentiles: per-case median, then corpus distribution ==="
query "
SELECT
    metric,
    round(quantileExact(0.50)(value), 3) AS p50,
    round(quantileExact(0.80)(value), 3) AS p80,
    round(quantileExact(0.90)(value), 3) AS p90,
    round(quantileExact(0.95)(value), 3) AS p95,
    round(quantileExact(0.99)(value), 3) AS p99
FROM osrs_bench.case_metrics
WHERE
    run_id = '$RUN_ID_SQL'
    AND metric IN (
        'total_ms',
        'account_prepare_ms',
        'heuristic_prepare_ms',
        'reverse_search_ms',
        'seed_table_ms',
        'forward_search_ms'
    )
GROUP BY metric
ORDER BY indexOf([
    'total_ms',
    'account_prepare_ms',
    'heuristic_prepare_ms',
    'reverse_search_ms',
    'seed_table_ms',
    'forward_search_ms'
], metric)
"

echo
echo "=== Search / heuristic work percentiles ==="
query "
SELECT
    metric,
    round(quantileExact(0.50)(value), 2) AS p50,
    round(quantileExact(0.80)(value), 2) AS p80,
    round(quantileExact(0.90)(value), 2) AS p90,
    round(quantileExact(0.95)(value), 2) AS p95,
    round(quantileExact(0.99)(value), 2) AS p99,
    round(max(value), 2) AS max
FROM osrs_bench.case_metrics
WHERE
    run_id = '$RUN_ID_SQL'
    AND metric IN (
        'states_popped',
        'unique_states_reached',
        'heuristic_calls',
        'heuristic_candidates_scanned',
        'heuristic_generator_count',
        'heuristic_max_generators_per_component',
        'heuristic_seed_count',
        'heuristic_max_seeds_per_component'
    )
GROUP BY metric
ORDER BY metric
"

echo
echo "=== Derived heuristic work ==="
query "
WITH cases AS
(
    SELECT
        profile,
        route_id,
        maxIf(value, metric = 'heuristic_candidates_scanned') AS candidates,
        maxIf(value, metric = 'heuristic_calls') AS calls,
        maxIf(value, metric = 'states_popped') AS popped,

        countIf(metric = 'heuristic_candidates_scanned') AS have_candidates,
        countIf(metric = 'heuristic_calls') AS have_calls,
        countIf(metric = 'states_popped') AS have_popped

    FROM osrs_bench.case_metrics

    WHERE
        run_id = '$RUN_ID_SQL'
        AND metric IN (
            'heuristic_candidates_scanned',
            'heuristic_calls',
            'states_popped'
        )

    GROUP BY profile, route_id
)
SELECT
    name,
    round(quantileExact(0.50)(v), 3) AS p50,
    round(quantileExact(0.80)(v), 3) AS p80,
    round(quantileExact(0.90)(v), 3) AS p90,
    round(quantileExact(0.95)(v), 3) AS p95,
    round(quantileExact(0.99)(v), 3) AS p99,
    round(max(v), 3) AS max
FROM
(
    SELECT
        'candidates / heuristic call' AS name,
        candidates / calls AS v
    FROM cases
    WHERE have_candidates > 0 AND have_calls > 0 AND calls > 0

    UNION ALL

    SELECT
        'candidates / popped state' AS name,
        candidates / popped AS v
    FROM cases
    WHERE have_candidates > 0 AND have_popped > 0 AND popped > 0

    UNION ALL

    SELECT
        'heuristic calls / popped state' AS name,
        calls / popped AS v
    FROM cases
    WHERE have_calls > 0 AND have_popped > 0 AND popped > 0
)
GROUP BY name
ORDER BY name
"

echo
echo "=== Generator-per-component metrics ==="
query "
SELECT
    metric,
    round(quantileExact(0.50)(value), 2) AS case_p50,
    round(quantileExact(0.90)(value), 2) AS case_p90,
    round(quantileExact(0.95)(value), 2) AS case_p95,
    round(quantileExact(0.99)(value), 2) AS case_p99,
    round(max(value), 2) AS max
FROM osrs_bench.case_metrics
WHERE
    run_id = '$RUN_ID_SQL'
    AND (
        metric LIKE 'heuristic_generators_per_component_%'
        OR metric = 'heuristic_max_generators_per_component'
    )
GROUP BY metric
ORDER BY metric
"

echo
echo "=== Total time by account profile ==="
query "
SELECT
    profile,
    round(quantileExact(0.50)(value), 3) AS p50,
    round(quantileExact(0.80)(value), 3) AS p80,
    round(quantileExact(0.90)(value), 3) AS p90,
    round(quantileExact(0.95)(value), 3) AS p95,
    round(quantileExact(0.99)(value), 3) AS p99
FROM osrs_bench.case_metrics
WHERE
    run_id = '$RUN_ID_SQL'
    AND metric = 'total_ms'
GROUP BY profile
ORDER BY profile
"

echo
echo "=== 10 slowest cases, with phase breakdown ==="
query "
SELECT
    profile,
    route_id,
    any(route_label) AS route,
    round(maxIf(value, metric = 'total_ms'), 2) AS total_ms,
    round(maxIf(value, metric = 'account_prepare_ms'), 2) AS account_ms,
    round(maxIf(value, metric = 'heuristic_prepare_ms'), 2) AS heuristic_ms,
    round(maxIf(value, metric = 'reverse_search_ms'), 2) AS reverse_ms,
    round(maxIf(value, metric = 'seed_table_ms'), 2) AS seeds_ms,
    round(maxIf(value, metric = 'forward_search_ms'), 2) AS forward_ms,
    toUInt64(maxIf(value, metric = 'states_popped')) AS popped,
    toUInt64(maxIf(value, metric = 'heuristic_candidates_scanned')) AS candidates,
    toUInt64(maxIf(value, metric = 'heuristic_max_generators_per_component')) AS max_generators
FROM osrs_bench.case_metrics
WHERE
    run_id = '$RUN_ID_SQL'
    AND metric IN (
        'total_ms',
        'account_prepare_ms',
        'heuristic_prepare_ms',
        'reverse_search_ms',
        'seed_table_ms',
        'forward_search_ms',
        'states_popped',
        'heuristic_candidates_scanned',
        'heuristic_max_generators_per_component'
    )
GROUP BY profile, route_id
ORDER BY total_ms DESC
LIMIT 10
"
